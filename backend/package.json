{
  "name": "coolestprojects",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@coolestprojects/database && npm run build --workspace=@coolestprojects/api",
    "build:database": "npm run build --workspace=@coolestprojects/database",
    "start:dev": "npm run start:dev --workspace=@coolestprojects/api"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10"
  }
}
