# Copy to /etc/presentation-sync.env, fill in the real values, then:
#   sudo chown presentation:presentation /etc/presentation-sync.env
#   sudo chmod 600 /etc/presentation-sync.env
# (it holds a password — keep it out of version control and readable only
# by the service's own user)

PRESENTATION_API_URL=https://api.coolestprojects.example/presentation
PRESENTATION_USER=presentation
PRESENTATION_PASSWORD=change-me

# Must match ReadWritePaths in presentation-sync.service.
OUTPUT_DIR=/var/lib/presentation-deck

POLL_INTERVAL_SECONDS=60

# Optional: hand off to feh (see ../feh-slideshow.sh) — uncomment to have
# feh restart automatically whenever the deck actually changes.
#
# IMPORTANT if you keep this env file wired to presentation-sync.service
# as templated (a headless, dedicated 'presentation' system user): that
# service has no DISPLAY/Xauthority, so ON_DECK_CHANGED_CMD won't be able
# to reach feh's X session as-is. Either add `Environment=DISPLAY=:0` and
# point XAUTHORITY at the graphical user's Xauthority file in the .service
# (and grant that user's X server access to the 'presentation' user), or
# — simpler — run sync-deck.sh as a systemd --user service under the same
# account that owns the graphical session (e.g. `pi`) instead of the
# separate system-level user, so DISPLAY/XAUTHORITY are just there already.
#
# FEH_LIST_FILE=/var/lib/presentation-deck/feh-list.txt
# FEH_TICK_SECONDS=1
# ON_DECK_CHANGED_CMD=/opt/coolestprojects/presentation/feh-slideshow.sh
