# Copy to /etc/presentation-sync.env, fill in the real values, then:
#   sudo chown presentation:presentation /etc/presentation-sync.env
#   sudo chmod 600 /etc/presentation-sync.env
# (it holds a password — keep it out of version control and readable only
# by the service's own user)

PRESENTATION_API_URL=https://api.coolestprojects.example/presentation
PRESENTATION_USER=presentation
PRESENTATION_PASSWORD=change-me

# Must match ReadWritePaths in presentation-sync.service.
OUTPUT_DIR=/var/lib/presentation-deck

POLL_INTERVAL_SECONDS=60

# Optional: hand off to a display client (see ../slideshow.sh) — uncomment
# to have it restart automatically whenever the deck actually changes.
#
# The fleet has mixed-generation Pis: newer ones default to Wayland
# (labwc), older ones only have X11. slideshow.sh auto-detects which
# session THIS device is actually running (WAYLAND_DISPLAY vs DISPLAY) and
# dispatches to imv-slideshow.sh or feh-slideshow.sh accordingly — use it
# here regardless of which generation this particular Pi is, rather than
# hand-picking feh vs imv per device. Set SLIDESHOW_CLIENT=imv or =feh
# below instead to force one, e.g. if a device's env vars don't reflect
# reality for some reason.
#
# IMPORTANT if you keep this env file wired to presentation-sync.service
# as templated (a headless, dedicated 'presentation' system user): that
# service has no DISPLAY/Xauthority (X11/feh) or
# WAYLAND_DISPLAY/XDG_RUNTIME_DIR (Wayland/imv), so ON_DECK_CHANGED_CMD
# can't reach either graphical session as-is. Either add the relevant
# `Environment=...` line(s) to the .service — `DISPLAY=:0` +
# `XAUTHORITY=<path>` for X11, or `WAYLAND_DISPLAY=...` +
# `XDG_RUNTIME_DIR=/run/user/<uid>` for Wayland — and grant the
# 'presentation' user access to that session, or — simpler — run
# sync-deck.sh as a systemd --user service under the same account that
# owns the graphical session (e.g. `pi`) instead of the separate
# system-level user, so these vars are just there already.
#
# SLIDE_LIST_FILE=/var/lib/presentation-deck/slide-list.txt
# SLIDE_TICK_SECONDS=1
# ON_DECK_CHANGED_CMD=/opt/coolestprojects/presentation/slideshow.sh
# SLIDESHOW_CLIENT=imv  # or: feh — omit this line entirely to auto-detect instead
