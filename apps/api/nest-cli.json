{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "./src",
  "monorepo": false,
  "compilerOptions": {
    "tsConfigPath": "./tsconfig.build.json",
    "deleteOutDir": true,
    "assets": [
      {
        "include": "seeder/fixtures/**/*",
        "outDir": "dist",
        "watchAssets": true
      }
    ]
  }
}