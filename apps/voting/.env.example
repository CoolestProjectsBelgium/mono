# Voting Application Environment Variables

# API Base URL for voting endpoints
# For static PWA builds: leave empty to auto-detect from window.location
# Or set explicitly for different API server
NUXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Production setup for static PWA:
# 1. Leave NUXT_PUBLIC_API_BASE_URL empty for same-origin API
# 2. Configure CORS on API to allow PWA domain
# 3. Or set to your API domain: https://api.yourdomain.com
# 4. Ensure API implements /voting/auth/refresh endpoint
# 5. Deploy both PWA and API over HTTPS

# For same-origin deployment:
# - PWA: https://yourdomain.com/voting
# - API: https://yourdomain.com/api
# - Set NUXT_PUBLIC_API_BASE_URL empty (auto-detects parent origin)
