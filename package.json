{
  "name": "coolestprojects monorepo",
  "version": "1.0.0",
  "description": "Monorepo for coolestprojects apps and packages",
  "main": "index.js",
  "scripts": {
    "test": "npm test --workspace=@coolestprojects/registration && npm test --workspace=@coolestprojects/api",
    "test:registration": "npm test --workspace=@coolestprojects/registration",
    "test:api": "npm test --workspace=@coolestprojects/api",
    "test:e2e": "npm run test:e2e --workspace=@coolestprojects/api",
    "dev:reload": "bash scripts/dev/reload.sh",
    "dev:restart:api": "bash scripts/dev/restart-api.sh",
    "dev:restart:registration": "bash scripts/dev/restart-registration.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "workspaces": [
    "packages/database",
    "apps/admin",
    "apps/api",
    "apps/eventguide",
    "apps/presentation",
    "apps/registration",
    "apps/voting"
  ],
  "allowScripts": {
    "esbuild@0.25.12": true,
    "@nestjs/core@11.1.24": true,
    "unrs-resolver@1.12.2": true,
    "bcrypt@6.0.0": true,
    "esbuild@0.28.1": true
  },
  "dependencies": {
    "@nestjs/cli": "^11.0.23"
  },
  "devDependencies": {
    "vite": "^6.4.3"
  }
}
