# Runtime (Level27 Node 24, command: node main.js, port 3001)
NODE_ENV=production
API_PORT=3001
API_BASE_URL=https://api-dev.coolestprojects-test.be
COOKIE_DOMAIN=coolestprojects-test.be
CORS_ORIGINS=https://registration-dev.coolestprojects-test.be,https://voting-dev.coolestprojects-test.be
REGISTRATION_URL=https://registration-dev.coolestprojects-test.be
WEBSITE_URL=https://coolestprojects.be
UPLOAD_ROOT=./uploads
CRON_JOB=*/1 * * * *

# Database (db-dev). Fill DB_HOST and DB_PASSWORD in secrets/api-dev.env
DB_DIALECT=mysql
DB_HOST=
DB_PORT=3306
DB_NAME=coolestproject
DB_USER=db35160
DB_PASSWORD=

# Secrets — overlay from build_tools/secrets/api-dev.env
JWT_KEY=
VOTING_KEY=
CSRF_SECRET=
ADMINJS_COOKIE_SECRET=

# Mail (mail-dev is Mailpit). Leave SMTP_HOST empty to log instead of send.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Coolest Project <info@coolestprojects.be>
SMTP_SECURE=false
