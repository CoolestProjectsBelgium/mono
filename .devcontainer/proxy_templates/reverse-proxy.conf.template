resolver 127.0.0.11 valid=30s ipv6=off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Browsers often open http://host:8443; port 8443 is TLS — redirect to https.
error_page 497 =301 https://$http_host$request_uri;

# admin.coolestprojects.localhost        3000
# api.coolestprojects.localhost          3001
# eventguide.coolestprojects.localhost   3002
# presentation.coolestprojects.localhost 3003
# registration.coolestprojects.localhost 3004
# voting.coolestprojects.localhost       3005
#
# Use variable proxy_pass so nginx resolves Docker service names at request
# time (avoids "host not found in upstream" when proxy starts before workspace).

server {
    listen 80;
    server_name .coolestprojects.localhost;
    return 301 https://$host:8443$request_uri;
}

# admin.coolestprojects.localhost (3000)
server {
    listen 443 ssl;
    server_name admin.coolestprojects.localhost;
    ssl_certificate     /etc/nginx/certs/pki/issued/admin.coolestprojects.localhost.crt;
    ssl_certificate_key /etc/nginx/certs/pki/private/admin.coolestprojects.localhost.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    location / {
        set $upstream_host workspace;
        proxy_pass http://$upstream_host:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

# api.coolestprojects.localhost (3001)
