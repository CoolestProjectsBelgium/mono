# registration.coolestprojects.localhost (3004)
server {
    listen 443 ssl;
    server_name registration.coolestprojects.localhost;
    ssl_certificate     /etc/nginx/certs/pki/issued/registration.coolestprojects.localhost.crt;
    ssl_certificate_key /etc/nginx/certs/pki/private/registration.coolestprojects.localhost.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Same-origin API proxy — avoids a separate TLS trust step for api.* in the browser.
    location /_api/ {
        set $upstream_host workspace;
        rewrite ^/_api/(.*)$ /$1 break;
        proxy_pass http://$upstream_host:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        set $upstream_host workspace;
        proxy_pass http://$upstream_host:3004;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

